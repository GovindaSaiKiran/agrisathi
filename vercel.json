{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "stitch_agrisaathi_mobile_dashboard_replicated/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/stitch_agrisaathi_mobile_dashboard_replicated/$1"
    }
  ]
}
